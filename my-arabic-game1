import { useState } from "react";
import { Button } from "@/components/ui/button";
import Image from "next/image";

export default function ArabicLetterGame() {
  const [letters, setLetters] = useState([
    "ب", "د", "و", "ص", "ق",
    "ث", "ه", "ض", "ي", "ح",
    "م", "ز", "ش", "ط", "ك",
    "أ", "ر", "س", "ظ", "ث",
    "ج", "ع", "ه", "غ", "ذ"
  ]);
  const [colors, setColors] = useState(Array(25).fill("white"));

  const shuffleLetters = () => {
    setLetters([...letters.sort(() => Math.random() - 0.5)]);
  };

  const changeColor = (index) => {
    setColors(colors.map((color, i) => i === index ? (color === "green" ? "orange" : "green") : color));
  };

  return (
    <div className="flex flex-col items-center space-y-4">
      <Image src="/your-image-path.jpg" alt="Arabic Letters" width={300} height={300} />
      <div className="grid grid-cols-5 gap-2">
        {letters.map((letter, index) => (
          <Button 
            key={index} 
            className={`w-12 h-12 text-xl border rounded ${colors[index]}`} 
            style={{ backgroundColor: colors[index] }}
            onClick={() => changeColor(index)}
          >
            {letter}
          </Button>
        ))}
      </div>
      <Button onClick={shuffleLetters} className="mt-4 p-2 bg-blue-500 text-white rounded">
        تغيير أماكن الحروف
      </Button>
    </div>
  );
}

